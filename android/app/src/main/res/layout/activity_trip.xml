<?xml version="1.0" encoding="utf-8"?>
<!-- Same background and margins as the app drawer: content below the line (~20%) and between
     the side arcs (~13% each side). Columns: Trip 1 | Now | Trip 2, like the car's display
     pages with the current one in the middle. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_drawer"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/goldman_regular"
        android:text="@string/title_trip"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <ImageButton
        android:id="@+id/homeButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.7"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home"
        android:contentDescription="@string/action_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20" />

        <LinearLayout
            android:id="@+id/tripColumns"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="72"
            android:layout_marginHorizontal="40dp"
            android:baselineAligned="false"
            android:divider="@drawable/bar_divider"
            android:orientation="horizontal"
            android:showDividers="middle" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="8" />

    </LinearLayout>

</FrameLayout>
